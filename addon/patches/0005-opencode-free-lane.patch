diff --git a/open-sse/executors/opencodeFreeTierContract.ts b/open-sse/executors/opencodeFreeTierContract.ts
index 5b2038ed..1c1bdfa0 100644
--- a/open-sse/executors/opencodeFreeTierContract.ts
+++ b/open-sse/executors/opencodeFreeTierContract.ts
@@ -184,22 +184,34 @@ function opencodeFreeModelCatalog(): ReadonlySet<string> | null {
  * Determine whether a model requires an API key on the given opencode provider.
  *
  * - `opencode-go`: ALL models require a key (no free tier).
- * - `opencode` / `opencode-zen`: premium = any model NOT in the synced free catalog
- *   (available ∩ free ∧ not deprecated). With no synced catalog, the legacy heuristic
- *   (`-free` suffix or the registry's known free ids) is used instead.
- * - Unknown models are assumed premium (fail-safe).
+ * - `opencode` / `opencode-zen`: a KNOWN-FREE id — the `-free` suffix or one of the
+ *   registry's free ids — is free unconditionally. Any other model is premium unless the
+ *   synced free catalog (available ∩ free ∧ not deprecated) lists it. With no synced
+ *   catalog the legacy heuristic decides, and an unknown id stays premium (fail-safe).
+ *
+ * The known-free ids short-circuit the catalog on purpose. The catalog is written by
+ * discovery, so it does not survive an import from `GET /models`: the imported rows carry
+ * no free flag, `catalog.has(id)` is false for every one of them, and a catalog-first
+ * answer turns a model the upstream still serves for free (`big-pickle`, the rotating
+ * `-free` ids) into a paid one — the 402/403 plus "model not found" pair reported against
+ * 3.8.53. A declarative free id is not less true because a snapshot missed it.
  */
 export function isPremiumOpencodeModel(model: string, provider: string): boolean {
   // opencode-go has no free tier — every model requires a key.
   if (provider === "opencode-go") return true;
 
   const id = model.trim();
+
+  // Declarative free ids beat the catalog, whether or not it is synced.
+  if (id.endsWith("-free") || OPENCODE_LEGACY_FREE_MODELS.has(id)) return false;
+
   const catalog = opencodeFreeModelCatalog();
   if (catalog) return !catalog.has(id);
 
-  // Unsynced catalog: the legacy rule, so an unsynced deployment keeps its behavior.
-  if (id.endsWith("-free")) return false;
-  return !OPENCODE_LEGACY_FREE_MODELS.has(id);
+  // No synced catalog: the known-free ids returned above, so whatever is left is premium.
+  // (This is the 3.8.52 rule — `!id.endsWith("-free") && !OPENCODE_LEGACY_FREE_MODELS.has(id)`
+  // — with the two legacy-free forms already consumed by the guard, hence the constant.)
+  return true;
 }
 
